<Project Sdk="Microsoft.NET.Sdk">
  <!-- lebr-snapshot：不開 Revit，由 .lebr.json 重算並產生／上傳控制台快照（教室 demo 備案用） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LebrCarbon.Cli</RootNamespace>
    <AssemblyName>lebr-snapshot</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LebrCarbon.Core\LebrCarbon.Core.csproj" />
    <ProjectReference Include="..\LebrCarbon.Data\LebrCarbon.Data.csproj" />
    <ProjectReference Include="..\LebrCarbon.Reports\LebrCarbon.Reports.csproj" />
    <ProjectReference Include="..\LebrCarbon.Dashboard\LebrCarbon.Dashboard.csproj" />
  </ItemGroup>
</Project>
